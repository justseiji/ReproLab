# ReproLab configuration. Copy to .env and adjust. Never commit real credentials.

# --- Database -------------------------------------------------------------
# Docker Compose (`npm run db:up`) and the no-Docker helper (`npm run db:local`)
# both listen on 127.0.0.1:5433.
DATABASE_URL=postgresql://reprolab:reprolab@127.0.0.1:5433/reprolab
# Used only by the integration tests, which truncate its tables.
TEST_DATABASE_URL=postgresql://reprolab:reprolab@127.0.0.1:5433/reprolab_test

# --- Demo store -----------------------------------------------------------
# Public storefront. This is the ONLY origin the browser agent may reach.
STORE_URL=http://localhost:4100
STORE_PORT=4100
# Demo-only bug switches. Bound to 127.0.0.1 on a separate port that the
# agent's browser is never allowed to contact.
STORE_ADMIN_PORT=4101
STORE_ADMIN_URL=http://127.0.0.1:4101

# --- API ------------------------------------------------------------------
# The API has no authentication. Keep it on localhost.
API_HOST=127.0.0.1
API_PORT=4000
ARTIFACT_DIR=.data/artifacts

# --- Worker ---------------------------------------------------------------
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_MS=1000
JOB_LEASE_MS=30000
JOB_MAX_ATTEMPTS=3
RUN_TIMEOUT_MS=120000
ACTION_TIMEOUT_MS=5000
MAX_ACTIONS_LIVE=15
HEADLESS=true

# --- Live AI mode (optional) ----------------------------------------------
# Leave this section alone to use scripted demo mode only (free, no key).
#
# AI_PROVIDER picks the model provider: anthropic | openai | gemini | ollama
#   anthropic  needs ANTHROPIC_API_KEY  (console.anthropic.com, pay per use)
#   openai     needs OPENAI_API_KEY     (platform.openai.com, pay per use)
#   gemini     needs GEMINI_API_KEY     (aistudio.google.com)
#   ollama     no key; runs a model on this computer (ollama.com), free
# Only the key for the selected provider is read.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Model name. Empty = the provider's default (packages/shared/src/ai-providers.ts):
# claude-opus-5-5, gpt-6-astra, gemini-3.6-flash, gpt-oss (Ollama).
AI_MODEL=
# Optional base URL overrides (proxies, OpenAI-compatible gateways, remote Ollama).
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# Reasoning effort (Anthropic only): low | medium | high
AI_EFFORT=low
AI_REQUEST_TIMEOUT_MS=60000
AI_MAX_OUTPUT_TOKENS=4000
# USD per million tokens. A cost estimate is recorded only when both prices are
# set AND the provider returned real token usage. Check current pricing first.
AI_PRICE_INPUT_USD_PER_MTOK=
AI_PRICE_OUTPUT_USD_PER_MTOK=
# Anthropic only. Server-side refusal fallback (Claude API beta "server-side-fallback-2026-07-01").
# If the model declines a request, the API retries it on Anthropic's recommended
# fallback model. Set to false to turn it off.
AI_REFUSAL_FALLBACK=true
