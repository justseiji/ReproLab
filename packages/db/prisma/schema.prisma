// ReproLab data model. Generated client lives in src/generated (git-ignored).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated"
  moduleFormat        = "esm"
  importFileExtension = ""
}

datasource db {
  provider = "postgresql"
}

enum RunMode {
  SCRIPTED
  LIVE_AI
}

enum RunStatus {
  QUEUED
  RUNNING
  COMPLETED
}

enum RunOutcome {
  REPRODUCED
  NOT_REPRODUCED
  INCONCLUSIVE
  EXECUTION_FAILED
}

enum JobStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum ArtifactKind {
  SCREENSHOT
  TRACE
}

model Report {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  description      String
  expectedBehavior String
  actualBehavior   String?
  /// Set only on seeded reports; links them to scripted demo recipes.
  seedKey          String?  @unique
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  runs             Run[]

  @@index([createdAt])
}

model Run {
  id                     String        @id @default(uuid()) @db.Uuid
  reportId               String        @db.Uuid
  report                 Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  mode                   RunMode
  status                 RunStatus     @default(QUEUED)
  /// Human-readable progress for the UI, e.g. "Launching browser".
  phase                  String?
  outcome                RunOutcome?
  reasonCode             String?
  summary                String?
  /// The explicit expected outcome (triggers + spec checks) used as the oracle.
  expectedOutcome        Json?
  clarification          String?
  checkResults           Json?
  observedTriggers       String[]      @default([])
  missingTriggers        String[]      @default([])
  /// Store bug switches at run start. Recorded as evidence; never read by the evaluator.
  storeConfig            Json?
  regressionTest         String?
  regressionTestFileName String?
  regressionTestNote     String?
  attempt                Int           @default(0)
  modelProvider          String?
  modelName              String?
  modelCalls             Int           @default(0)
  inputTokens            Int?
  outputTokens           Int?
  estimatedCostUsd       Float?
  createdAt              DateTime      @default(now()) @db.Timestamptz(3)
  startedAt              DateTime?     @db.Timestamptz(3)
  finishedAt             DateTime?     @db.Timestamptz(3)
  durationMs             Int?
  job                    Job?
  actions                RunAction[]
  evidence               RunEvidence[]
  artifacts              Artifact[]
  events                 RunEvent[]

  @@index([reportId, createdAt])
}

model RunAction {
  id           String   @id @default(uuid()) @db.Uuid
  runId        String   @db.Uuid
  run          Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempt      Int
  index        Int
  type         String
  /// The validated action exactly as executed.
  input        Json
  description  String
  /// "succeeded" | "failed" | "rejected"
  status       String
  error        String?
  rationale    String?
  locator      Json?
  pageUrl      String?
  triggers     String[] @default([])
  screenshotId String?  @db.Uuid
  startedAt    DateTime @db.Timestamptz(3)
  durationMs   Int?

  @@unique([runId, attempt, index])
}

model RunEvidence {
  id      String   @id @default(uuid()) @db.Uuid
  runId   String   @db.Uuid
  run     Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempt Int
  /// console_error | page_error | request_failed | http_error | request_blocked
  kind    String
  message String
  url     String?
  at      DateTime @default(now()) @db.Timestamptz(3)

  @@index([runId])
}

model Artifact {
  id           String       @id @default(uuid()) @db.Uuid
  runId        String       @db.Uuid
  run          Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  attempt      Int
  kind         ArtifactKind
  label        String
  /// Path relative to ARTIFACT_DIR, generated by the worker (never user input).
  relativePath String
  contentType  String
  sizeBytes    Int
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)

  @@index([runId])
}

model RunEvent {
  id      String   @id @default(uuid()) @db.Uuid
  runId   String   @db.Uuid
  run     Run      @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// info | warn | error
  level   String
  message String
  at      DateTime @default(now()) @db.Timestamptz(3)

  @@index([runId, at])
}

/// One job per run. Claimed atomically with FOR UPDATE SKIP LOCKED and held
/// through a renewable lease (lockedUntil). See src/queue.ts.
model Job {
  id          String    @id @default(uuid()) @db.Uuid
  runId       String    @unique @db.Uuid
  run         Run       @relation(fields: [runId], references: [id], onDelete: Cascade)
  status      JobStatus @default(QUEUED)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  runAfter    DateTime  @default(now()) @db.Timestamptz(3)
  lockedBy    String?
  lockedUntil DateTime? @db.Timestamptz(3)
  lastError   String?
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @db.Timestamptz(3)

  @@index([status, runAfter])
}
